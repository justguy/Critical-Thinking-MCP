{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "intervention",
    "failure_modes_addressed",
    "affected_tasks",
    "critical_count",
    "high_count",
    "medium_count",
    "low_count",
    "preventability",
    "confidence",
    "affected_workflow_importance",
    "implementation_cost",
    "friction_risk",
    "value_score",
    "recommended_action",
    "minimum_viable_change"
  ],
  "properties": {
    "intervention": { "type": "string", "minLength": 1 },
    "failure_modes_addressed": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "affected_tasks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "critical_count": { "type": "integer", "minimum": 0 },
    "high_count": { "type": "integer", "minimum": 0 },
    "medium_count": { "type": "integer", "minimum": 0 },
    "low_count": { "type": "integer", "minimum": 0 },
    "counterfactual_critical_risk_count": { "type": "integer", "minimum": 0 },
    "preventability": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "affected_workflow_importance": { "type": "number", "minimum": 1 },
    "implementation_cost": { "type": "number", "exclusiveMinimum": 0 },
    "friction_risk": { "type": "number", "minimum": 0 },
    "value_score": { "type": "number" },
    "recommended_action": { "enum": ["build", "prototype", "defer", "kill"] },
    "minimum_viable_change": { "type": "string", "minLength": 1 },
    "score_basis": { "type": "string" }
  }
}
