{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "task_id",
    "task_type",
    "original_request",
    "agent_answer",
    "artifacts_supplied",
    "mode",
    "model",
    "tool_surface",
    "accepted_by_user_or_eval",
    "notes"
  ],
  "properties": {
    "task_id": { "type": "string", "minLength": 1 },
    "task_type": { "type": "string", "minLength": 1 },
    "original_request": { "type": "string", "minLength": 1 },
    "agent_answer": { "type": "string", "minLength": 1 },
    "artifacts_supplied": {
      "type": "object",
      "required": ["sources", "claims", "numbers", "constraints", "contract"],
      "properties": {
        "sources": { "type": "array" },
        "claims": { "type": "array" },
        "numbers": { "type": "array" },
        "constraints": { "type": "array" },
        "contract": {}
      }
    },
    "mode": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "tool_surface": { "enum": ["none", "advisory", "facade", "raw"] },
    "accepted_by_user_or_eval": { "type": "boolean" },
    "notes": { "type": "string" }
  }
}
